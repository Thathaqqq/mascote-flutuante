{
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/iniciar.py\" auto", "timeout": 10}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/registrar_estado.py\" UserPromptSubmit", "timeout": 5}]}],
    "PreToolUse": [{"matcher": "*", "hooks": [{"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/registrar_estado.py\" PreToolUse", "timeout": 5}]}],
    "Notification": [{"hooks": [{"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/registrar_estado.py\" Notification", "timeout": 5}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/registrar_estado.py\" Stop", "timeout": 5}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/registrar_estado.py\" SessionEnd", "timeout": 5}]}]
  }
}
